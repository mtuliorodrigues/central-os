@@ -2627,0 +2640,143 @@ export class BaileysStartupService extends ChannelStartupService {
+  // RELATORIO_OS_NATIVE_FORWARD
+  public async forwardMessage(data: { number: string; message: WAMessage; forceForward?: boolean }) {
+    if (!data?.number) {
+      throw new BadRequestException('Destination number/group is required');
+    }
+
+    if (!data?.message?.message) {
+      throw new BadRequestException('Original WAMessage is required');
+    }
+
+    // Use the standard send pipeline so the forwarded message is persisted
+    // and emits the same logs/webhooks as every other outgoing message.
+    return await this.sendMessageWithTyping(
+      data.number,
+      {
+        forward: data.message,
+        force: data.forceForward ?? true,
+      } as any,
+    );
+  }
+
+  // RELATORIO_OS_SYNC_HISTORY_DIRECT
+  public async syncHistory(data: {
+    key: WAMessageKey;
+    messageTimestamp: number;
+    count?: number;
+    timeoutMs?: number;
+  }) {
+    if (!data?.key?.remoteJid || !data?.key?.id || !data?.messageTimestamp) {
+      throw new BadRequestException('key and messageTimestamp are required');
+    }
+
+    const count = Math.min(50, Math.max(1, Number(data.count ?? 50)));
+    const timeoutMs = Math.min(30000, Math.max(5000, Number(data.timeoutMs ?? 18000)));
+    const remoteJid = data.key.remoteJid;
+
+    let requestId: string | undefined;
+
+    const result = await new Promise<{
+      messages: WAMessage[];
+      timedOut: boolean;
+      eventSyncType?: number;
+      peerDataRequestSessionId?: string;
+      totalEventMessages?: number;
+    }>(async (resolve, reject) => {
+      let finished = false;
+      let timer: ReturnType<typeof setTimeout>;
+
+      const cleanup = () => {
+        try {
+          this.client.ev.off('messaging-history.set', handler as any);
+        } catch {}
+        if (timer) {
+          clearTimeout(timer);
+        }
+      };
+
+      const handler = (event: any) => {
+        if (finished) {
+          return;
+        }
+
+        const syncType = event?.syncType;
+
+        if (syncType !== proto.HistorySync.HistorySyncType.ON_DEMAND) {
+          return;
+        }
+
+        const eventRequestId = event?.peerDataRequestSessionId
+          ? String(event.peerDataRequestSessionId)
+          : undefined;
+
+        // Nas versões que fornecem peerDataRequestSessionId, amarra o
+        // retorno ao requestId desta chamada.
+        if (requestId && eventRequestId && eventRequestId !== requestId) {
+          return;
+        }
+
+        const allMessages: WAMessage[] = Array.isArray(event?.messages) ? event.messages : [];
+        const groupMessages = allMessages.filter(
+          (message: WAMessage) => message?.key?.remoteJid === remoteJid,
+        );
+
+        finished = true;
+        cleanup();
+
+        resolve({
+          messages: groupMessages,
+          timedOut: false,
+          eventSyncType: syncType,
+          peerDataRequestSessionId: eventRequestId,
+          totalEventMessages: allMessages.length,
+        });
+      };
+
+      this.client.ev.on('messaging-history.set', handler as any);
+
+      timer = setTimeout(() => {
+        if (finished) {
+          return;
+        }
+
+        finished = true;
+        cleanup();
+
+        resolve({
+          messages: [],
+          timedOut: true,
+          totalEventMessages: 0,
+        });
+      }, timeoutMs);
+
+      try {
+        const id = await this.client.fetchMessageHistory(
+          count,
+          data.key,
+          data.messageTimestamp as any,
+        );
+
+        requestId = id ? String(id) : undefined;
+      } catch (error) {
+        if (!finished) {
+          finished = true;
+          cleanup();
+          reject(error);
+        }
+      }
+    });
+
+    return {
+      requestId,
+      requestedCount: count,
+      remoteJid,
+      timeoutMs,
+      received: result.messages.length,
+      totalEventMessages: result.totalEventMessages ?? result.messages.length,
+      timedOut: result.timedOut,
+      eventSyncType: result.eventSyncType,
+      peerDataRequestSessionId: result.peerDataRequestSessionId,
+      messages: result.messages,
+    };
+  }
+

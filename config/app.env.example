# Central OS Integrada - configuracao local (NAO versionar app.env real)
CENTRAL_OS_PORT=8788
CENTRAL_OS_ROOT=

# Infraestrutura EXISTENTE. Esta fase nao cria nova Evolution/PostgreSQL.
EVOLUTION_BASE_URL=http://127.0.0.1:8080
EVOLUTION_INSTANCE=sgp-whatsapp
EVOLUTION_CONTAINER=evolution_api
EVOLUTION_EXPECTED_IMAGE=evolution-api-forward-sync-direct:2.3.7-phase2-fix1
AUTHENTICATION_API_KEY=
POSTGRES_CONTAINER=evolution_postgres
POSTGRES_USER=evolution
POSTGRES_DB=evolution
REDIS_CONTAINER=evolution_redis

# Compose legado existente, usado somente para subir a infraestrutura atual apos reboot.
EVOLUTION_EXISTING_DIR=C:\EvolutionSGP\evolution
ALLOW_START_EXISTING_EVOLUTION=true

# Relatorio OS
RELATORIO_ALLOW_WEB_EXECUTION=true
RELATORIO_PLANILHAS_DIR=
RELATORIO_GROUPS_FILE=
RELATORIO_USERS_FILE=
RELATORIO_OUTPUT_DIR=
RELATORIO_LISTENER_LOG_DIR=
RELATORIO_PYTHON=

# Frontend React: true força a interface HTML legada mesmo após o build.
CENTRAL_OS_LEGACY_UI=false

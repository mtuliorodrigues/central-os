{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm --prefix apps/central-os/frontend ci",
  "buildCommand": "npm --prefix apps/central-os/frontend run build",
  "outputDirectory": "apps/central-os/frontend/dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/(.*)", "destination": "/" }
  ]
}
